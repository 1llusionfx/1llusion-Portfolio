# Last.fm — https://www.last.fm/api/account/create
# Server-side only. No NEXT_PUBLIC_ prefix, so it stays out of the client bundle.
LASTFM_API_KEY=
LASTFM_USERNAME=

# Optional: Upstash Redis backing for the view counter.
# On Vercel: Storage > Upstash Redis — these two vars are injected automatically.
# Without them the counter falls back to the public counterapi.dev service.
KV_REST_API_URL=
KV_REST_API_TOKEN=
